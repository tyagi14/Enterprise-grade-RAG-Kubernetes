# Copy to .env and fill in. Never commit the real file. See DOCS/07_ENVIRONMENT_VARIABLES.md.

# --- Vector DB (Qdrant Cloud) ---
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# --- LLM keys (Groq). Production answers + guardrail fallback ---
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=

# --- Eval judge keys: use Groq keys from DIFFERENT organizations than the production keys above.
# Groq limits tokens per organization, so a judge key in the production org drains live chat.
# The judge never falls back to GROQ_API_KEY.
JUDGE_GROQ=
JUDGE_GROQ_2=
JUDGE_GROQ_3=
# Optional: JUDGE_MODELS="qwen/qwen3.8-27b,openai/gpt-oss-20b"

# --- Guardrails (NVIDIA hosted models) ---
NVIDIA_API_KEY=

# --- LLM gateway (Portkey) ---
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=

# --- Observability ---
LOGFIRE_TOKEN=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- GCP ---
PROJECT_ID=
LOCATION=us-central1
GCP_DOC_AI_LOCATION=us
GCP_DOC_AI_PROCESSOR_ID=
GCP_RAW_BUCKET=
GCP_PROCESSED_BUCKET=

# --- Conversation memory (Cloud SQL Postgres) ---
DB_USER=
DB_PASS=
DB_NAME=
DB_HOST=127.0.0.1
LOCAL_MODE=true

# --- Semantic cache (Redis) ---
REDIS_HOST=
REDIS_PORT=6379
USE_SEMANTIC_CACHE=true
CACHE_DISTANCE_THRESHOLD=
CACHE_TTL_SECONDS=3600

# --- Evals ---
BACKEND_URL=http://localhost:8000
